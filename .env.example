# ---------------------------------------------------------------------------
# Layout-Aware RAG Benchmark -- environment template
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored; never commit real keys.
# ---------------------------------------------------------------------------

# LlamaParse / LlamaCloud  (Pipeline B)
# Get one at https://cloud.llamaindex.ai -> API Keys.  Format: llx-...
LLAMA_CLOUD_API_KEY=

# Google Gemini  (embeddings + generation, all three pipelines)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Model selection (override only if you know why)
# ---------------------------------------------------------------------------
# Text embedding model used by Pipelines A and B.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Generator used by every pipeline. Must be vision-capable for Pipeline C.
GEMINI_LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Only needed for gated/rate-limited Hugging Face downloads in src/dataset.py.
HF_TOKEN=
